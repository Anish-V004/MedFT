# ─── Fine-Tuned PV Model (AMD Infra) ─────────────────────────────────────────
JUPYTER_BASE_URL=https://notebooks.amd.com/your-notebook-id
JUPYTER_TOKEN=your_jupyter_token_here
FINETUNED_MODEL_BASE_URL=${JUPYTER_BASE_URL}/proxy/5000/v1
FINETUNED_MODEL_NAME=medft
FINETUNED_API_KEY=changeme

# Fine-tuned model generation params
FINETUNED_MAX_TOKENS=1024
FINETUNED_TEMPERATURE=0.1
FINETUNED_TOP_P=0.9

# ─── Summary / Consolidation Model (Ollama Cloud) ────────────────────────────
BASE_MODEL_BASE_URL=https://api.ollama.cloud/v1
BASE_MODEL_NAME=gpt-oss-20b
BASE_MODEL_API_KEY=your_ollama_api_key_here

# Base model generation params
BASE_MAX_TOKENS=2048
BASE_TEMPERATURE=0.3
